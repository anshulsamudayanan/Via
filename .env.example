# VIA environment configuration.
# Copy to .env and adjust. Never commit real secrets.
# Variables marked (CPn) are consumed from that checkpoint on.

# --- General -----------------------------------------------------------------
VIA_ENV=development                 # development | test | production

# --- API (CP2) ---------------------------------------------------------------
# Long random string; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VIA_SECRET_KEY=change-me
VIA_DATABASE_URL=postgresql+psycopg://via:via@localhost:5432/via
VIA_REDIS_URL=redis://localhost:6379/0
VIA_CORS_ORIGINS=http://localhost:3000   # comma-separated allowlist

# --- Object storage (CP2) ----------------------------------------------------
VIA_STORAGE_BACKEND=s3              # s3 | local
VIA_S3_ENDPOINT_URL=http://localhost:9000
VIA_S3_BUCKET=via-designs
VIA_S3_ACCESS_KEY=via-minio
VIA_S3_SECRET_KEY=change-me-minio-secret
VIA_LOCAL_STORAGE_PATH=./data/storage

# --- Uploads & parsing (CP4) -------------------------------------------------
VIA_MAX_UPLOAD_BYTES=52428800       # 50 MiB
VIA_PARSER_TIMEOUT_SECONDS=60
VIA_PARSER_MEMORY_LIMIT_MB=1024

# --- Web (CP2) ---------------------------------------------------------------
VIA_API_INTERNAL_URL=http://localhost:8000   # where the Next.js server proxies /api/*

# --- AI (CP5): disabled unless a provider is configured ----------------------
VIA_AI_PROVIDER=none                # none | anthropic
ANTHROPIC_API_KEY=
