# VIA environment configuration.
# Copy to `.env` and replace every `change-me` value. Never commit `.env`.
# Docker Compose reads this file; the API also reads it when run natively.

# --- General -----------------------------------------------------------------
VIA_ENV=development                     # development | test | production
VIA_LOG_LEVEL=INFO
# Random string, >= 32 chars in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VIA_SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL (Compose) -----------------------------------------------------
POSTGRES_USER=via
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=via

# --- MinIO / S3 (Compose) -----------------------------------------------------
MINIO_ROOT_USER=via-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret   # >= 8 characters
VIA_S3_BUCKET=via-designs
# Development only: create the bucket on startup. Must be false in production.
VIA_S3_AUTO_CREATE_BUCKET=true
# Optional: use a prebuilt MinIO image instead of building from source.
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# --- API ------------------------------------------------------------------------
VIA_CORS_ORIGINS=http://localhost:3000  # comma-separated allowlist, never "*"
VIA_MAX_UPLOAD_BYTES=52428800           # 50 MiB (enforced from CP4)

# --- Sessions & accounts --------------------------------------------------------
VIA_PUBLIC_WEB_URL=http://localhost:3000 # used in password-reset links
VIA_SESSION_TTL_HOURS=336               # 14 days
# VIA_SESSION_COOKIE_SECURE=            # unset = Secure cookies in production only
VIA_PASSWORD_RESET_TTL_MINUTES=60
VIA_RATE_LIMIT_ENABLED=true
# Email delivery: none in Stage 1. In development the API logs password-reset
# emails (with the link); in production they are not sent.

# --- Running the API natively (without Compose) --------------------------------
# Compose sets these itself. For `via-api serve` on the host, point at the
# Compose services (host ports below) or your own instances:
# VIA_DATABASE_URL=postgresql+psycopg://via:change-me-postgres@localhost:5432/via
# VIA_REDIS_URL=redis://localhost:6379/0
# VIA_STORAGE_BACKEND=s3                # s3 | local
# VIA_S3_ENDPOINT_URL=http://localhost:9000
# VIA_S3_ACCESS_KEY=via-minio
# VIA_S3_SECRET_KEY=change-me-minio-secret
# VIA_LOCAL_STORAGE_PATH=./data/storage # when VIA_STORAGE_BACKEND=local

# --- Web (native `pnpm dev`) ----------------------------------------------------
# VIA_API_INTERNAL_URL=http://localhost:8000

# --- Host ports (Compose, bound to 127.0.0.1) -----------------------------------
# WEB_HOST_PORT=3000
# API_HOST_PORT=8000
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001

# --- Integration tests (pytest) -------------------------------------------------
# VIA_TEST_DATABASE_URL=postgresql+psycopg://via:change-me-postgres@localhost:5432/via_test
# VIA_TEST_REDIS_URL=redis://localhost:6379/15
# VIA_TEST_S3_ENDPOINT=http://localhost:9000
# VIA_TEST_S3_ACCESS_KEY=via-minio
# VIA_TEST_S3_SECRET_KEY=change-me-minio-secret

# --- Image builds behind a TLS-intercepting proxy (optional) --------------------
# Path to an extra CA bundle used only during `docker compose build`.
# VIA_BUILD_CA_CERT=/path/to/corporate-ca.pem
